-- MAIN
local function openMain()
    keyFrame:Destroy()

    local main = new("Frame", {
        Size = UDim2.fromOffset(350,260),
        Position = UDim2.new(.5,-175,.5,-130),
        BackgroundColor3 = Color3.fromRGB(17,17,26)
    }, gui)
    corner(main,12)

    new("TextLabel", {
        Size = UDim2.new(1,0,0,40),
        BackgroundTransparency = 1,
        Text = "TRUECHANCEONLYHERE",
        TextColor3 = Color3.fromRGB(190,140,255),
        TextScaled = true,
        Font = Enum.Font.GothamBold
    }, main)

    -- IMAGE BAR: NO FRAMES, NO TEXT
    local imageBar = new("Frame", {
        Size = UDim2.new(1,-30,0,100),
        Position = UDim2.new(0,15,0,55),
        BackgroundTransparency = 1
    }, main)

    local function jump()
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.Jump = true
        end
    end

    local ids = {
        "rbxassetid://107978334321685",
        "rbxassetid://94583797890920"
    }

    for i,id in ipairs(ids) do
        local image = new("ImageButton", {
            Size = UDim2.fromOffset(100,100),
            Position = UDim2.new(0,(i-1)*115,0,0),
            BackgroundTransparency = 1,
            Image = id,
            AutoButtonColor = false
        }, imageBar)

        image.MouseButton1Click:Connect(jump)
    end

    -- HOME
    local home = new("Frame", {
        Size = UDim2.new(1,-30,0,75),
        Position = UDim2.new(0,15,0,170),
        BackgroundColor3 = Color3.fromRGB(27,27,40)
    }, main)
    corner(home,8)

    new("TextLabel", {
        Size = UDim2.new(1,0,1,0),
        BackgroundTransparency = 1,
        Text = "COMING SOON",
        TextColor3 = Color3.fromRGB(190,140,255),
        TextScaled = true,
        Font = Enum.Font.GothamBold
    }, home)

    -- DRAG WINDOW
    local dragging, dragStart, startPos

    main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)

    main.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

unlock.MouseButton1Click:Connect(function()
    if keyBox.Text == "bypass" then
        openMain()
    else
        keyBox.Text = ""
        keyBox.PlaceholderText = "Wrong key!"
    end
end)
